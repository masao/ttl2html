#!/usr/bin/env ruby

require "zlib"
require "getoptlong"
require "ttl2html"
include TTL2HTML

prefix = {}
ttl = []
noexpand_filenames = false

opts = GetoptLong.new(
  ["--no-expand", "-f", GetoptLong::NO_ARGUMENT],
  ["--help", "-h", GetoptLong::NO_ARGUMENT]
)

opts.each do |opt, arg|
  case opt
  when "--no-expand"
    noexpand_filenames = true
  when "--help"
    puts "Usage: catttl [options] [files]"
    puts "Options:"
    puts "  -f, --no-expand  Do not expand filenames"
    puts "  -h, --help        Show this help message"
    exit
  end
end

ARGV.each do |file|
  filename = find_turtle(file, noexpand: noexpand_filenames)
  if filename.nil?
    STDERR.puts "#{file} not found. skipping."
    next
  end
  STDERR.puts filename
  klass = File
  if File.extname(filename) == ".gz"
    klass = Zlib::GzipReader
  end
  io = klass.open(filename)
  io.each do |line|
    line = line.chomp
    next if line.empty?
    if line =~ /^@prefix\s+(\w[\w\-]*):\s*<(.+)>/
      prefix[$1] ||= []
      prefix[$1] << $2
    else
      ttl << line
    end
  end
end

prefix.each do |k, v|
  STDERR.puts "Duplicate prefixes: #{k}: #{v.uniq}" if v.uniq.size > 1
  prefix[k] = v.sort.first
end
dups = prefix.values.group_by{|e| e }.select{|k, v| v.size > 1 }.keys
unless dups.empty?
  dups.each do |uri|
    uris = prefix.keys.select{|e| prefix[e] == uri }
    STDERR.puts "Duplicate prefixes: #{uri} (#{uris.join(",")})"
  end
end

prefix.sort.each do |prefix, uri|
  puts "@prefix #{prefix}: <#{uri}>."
end
puts ttl
